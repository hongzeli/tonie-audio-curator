{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonie-audio-curator.local/schemas/selection.schema.json",
  "title": "Confirmed Tonie Audio Selection",
  "type": "object",
  "required": ["schema_version", "job_id", "confirmed_at", "source_recommendations", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "source_recommendations": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "source_page_url", "direct_download_url", "license"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 8},
          "title": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "source_page_url": {"type": "string", "format": "uri"},
          "direct_download_url": {"type": "string", "format": "uri"},
          "author": {"type": ["string", "null"]},
          "license": {"type": "string", "minLength": 1, "not": {"enum": ["unknown", "unclear"]}},
          "license_url": {"type": ["string", "null"]}
        }
      }
    }
  }
}
